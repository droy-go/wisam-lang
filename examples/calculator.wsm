# حاسبة بلغة وسام
# Calculator in Wisam

اكتب "=== حاسبة وسام ==="

دالة جمع تأخذ أ و ب
    أعد أ + ب
انتهى

دالة طرح تأخذ أ و ب
    أعد أ - ب
انتهى

دالة ضرب تأخذ أ و ب
    أعد أ * ب
انتهى

دالة قسمة تأخذ أ و ب
    إذا ب == 0 إذن
        اكتب "خطأ: لا يمكن القسمة على صفر"
        أعد 0
    انتهى
    أعد أ / ب
انتهى

# اختبار الحاسبة
ليكن رقم1 = 10
ليكن رقم2 = 5

اكتب "الأرقام: " + رقم1 + " و " + رقم2

ليكن نتيجة_الجمع = جمع(رقم1 ، رقم2)
اكتب "الجمع: " + نتيجة_الجمع

ليكن نتيجة_الطرح = طرح(رقم1 ، رقم2)
اكتب "الطرح: " + نتيجة_الطرح

ليكن نتيجة_الضرب = ضرب(رقم1 ، رقم2)
اكتب "الضرب: " + نتيجة_الضرب

ليكن نتيجة_القسمة = قسمة(رقم1 ، رقم2)
اكتب "القسمة: " + نتيجة_القسمة

# اختبار القسمة على صفر
ليكن نتيجة_خطأ = قسمة(10 ، 0)
