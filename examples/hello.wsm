# مرحبا بك في لغة وسام
# Hello World in Wisam Programming Language

ليكن اسم هو "وسام"
ثابت إصدار = 1.0
ليكن رقم هو 10

اكتب "مرحبا بك في {اسم}"
اكتب "الإصدار: {إصدار}"

إذا رقم > 5 إذن
    اكتب "الرقم أكبر من خمسة"
وإلا
    اكتب "الرقم صغير"
انتهى

لكل عدد من 1 إلى 3
    اكتب "عدد: {عدد}"
انتهى

دالة جمع تأخذ أ و ب
    أعد أ + ب
انتهى

ليكن نتيجة هو جمع(5 ، 7)
اكتب "نتيجة الجمع: {نتيجة}"

هيكل طالب
    اسم
    عمر
انتهى

ليكن أحمد هو طالب
أحمد.اسم = "أحمد"
أحمد.عمر = 20

اكتب أحمد.اسم

ليكن نص هو "لغة وسام قوية"
