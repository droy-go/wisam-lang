# ملف نموذجي للغة وسام
# Sample Wisam language file

ليكن اسم = "وسام"
ليكن إصدار = 1.0
ثابت PI = 3.14159

اكتب "مرحبا بك في " + اسم

دالة جمع تأخذ أ و ب
    أعد أ + ب
انتهى

لكل عدد من 1 إلى 5
    ليكن نتيجة = جمع(عدد ، 10)
    اكتب "النتيجة: " + نتيجة
انتهى

هيكل طالب
    الاسم
    العمر
    المعدل
انتهى

ليكن أحمد = طالب
أحمد.الاسم = "أحمد محمد"
أحمد.العمر = 20
أحمد.المعدل = 3.75

إذا أحمد.المعدل >= 3.5 إذن
    اكتب "ممتاز!"
وإلا
    اكتب "يحتاج تحسين"
انتهى
