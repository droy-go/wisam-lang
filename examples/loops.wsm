# أمثلة على الحلقات في لغة وسام
# Loop examples in Wisam

اكتب "=== أمثلة على الحلقات ==="

# حلقة لكل
اكتب "\n--- حلقة لكل ---"
لكل عدد من 1 إلى 5
    اكتب "العدد: " + عدد
انتهى

# حلقة مع شرط
اكتب "\n--- حلقة طالما ---"
ليكن عداد = 1
طالما عداد <= 5
    اكتب "العداد: " + عداد
    عداد = عداد + 1
انتهى

# جدول الضرب
اكتب "\n--- جدول الضرب ---"
لكل س من 1 إلى 5
    لكل ص من 1 إلى 5
        ليكن ناتج = س * ص
        اكتب س + " × " + ص + " = " + ناتج
    انتهى
    اكتب "---"
انتهى

# حساب المجموع
اكتب "\n--- حساب مجموع الأرقام ---"
ليكن مجموع = 0
لكل رقم من 1 إلى 10
    مجموع = مجموع + رقم
انتهى
اكتب "مجموع الأرقام من 1 إلى 10: " + مجموع

# حساب العاملية
اكتب "\n--- حساب العاملية ---"
دالة عاملية تأخذ ن
    إذا ن <= 1 إذن
        أعد 1
    انتهى
    أعد ن * عاملية(ن - 1)
انتهى

لكل رقم من 1 إلى 5
    ليكن ناتج = عاملية(رقم)
    اكتب رقم + "! = " + ناتج
انتهى
