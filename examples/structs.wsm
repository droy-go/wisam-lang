# أمثلة على الهياكل في لغة وسام
# Struct examples in Wisam

اكتب "=== أمثلة على الهياكل ==="

# تعريف هيكل الطالب
هيكل طالب
    اسم
    عمر
    المعدل
انتهى

# تعريف هيكل المادة
هيكل مادة
    الاسم
    الرمز
    الساعات
انتهى

# إنشاء كائنات
ليكن أحمد هو طالب
أحمد.اسم = "أحمد محمد"
أحمد.عمر = 20
أحمد.المعدل = 3.75

ليكن خالد هو طالب
خالد.اسم = "خالد عبدالله"
خالد.عمر = 22
خالد.المعدل = 3.90

ليكن رياضيات هو مادة
رياضيات.الاسم = "الرياضيات"
رياضيات.الرمز = "MATH101"
رياضيات.الساعات = 3

# عرض البيانات
اكتب "--- بيانات الطلاب ---"
اكتب "الطالب: " + أحمد.اسم
اكتب "العمر: " + أحمد.عمر
اكتب "المعدل: " + أحمد.المعدل

اكتب ""
اكتب "الطالب: " + خالد.اسم
اكتب "العمر: " + خالد.عمر
اكتب "المعدل: " + خالد.المعدل

اكتب ""
اكتب "--- بيانات المادة ---"
اكتب "المادة: " + رياضيات.الاسم
اكتب "الرمز: " + رياضيات.الرمز
اكتب "الساعات: " + رياضيات.الساعات

# مقارنة الطلاب
اكتب ""
اكتب "--- مقارنة المعدلات ---"
إذا أحمد.المعدل > خالد.المعدل إذن
    اكتب "أحمد لديه معدل أعلى"
وإلا
    إذا خالد.المعدل > أحمد.المعدل إذن
        اكتب "خالد لديه معدل أعلى"
    وإلا
        اكتب "المعدلات متساوية"
    انتهى
انتهى
